# OPTIONAL. Everything below can be set in the dashboard under Settings; settings saved there win over this file.
# This file is only for starting without a browser, for example on a server or in a container.
# Settings for the Application Tracker.
#   Windows desktop test:  copy this file to  .env  next to run.bat
#   Laptop service (WSL2): install.sh copies it to ~/.config/application-tracker.env  (keep it chmod 600)
# This file holds a password. Never commit it, never paste it into a chat.

# ---- the language model (Ollama runs on your desktop) ----
TRACKER_CLASSIFIER=ollama
# Same PC as Ollama:  http://localhost:11434   From the laptop:  http://<desktop-tailscale-name-or-100.x.y.z>:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Proton Mail Bridge (copy the values Bridge shows you) ----
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURITY=starttls
IMAP_USER=your-address@proton.me
# The password BRIDGE generated for the IMAP/SMTP connection. NOT your Proton login password.
IMAP_PASSWORD=
# Folder or label to read. Easier: pick it from the list in the dashboard (Settings).
IMAP_MAILBOX=INBOX
# Optional: pin Bridge's certificate (Bridge > Settings > Advanced > Export TLS certificates).
# IMAP_CAFILE=

# Hard cutoff: mail sent before this date is never stored (YYYY-MM-DD, empty = no cutoff).
# Raising it later: run `python -m tracker prune --yes` to delete what is now older. Lowering it: the next check re-reads the label.
EARLIEST_DATE=2026-01-01

# How often to check for new mail, in seconds.
POLL_SECONDS=300
